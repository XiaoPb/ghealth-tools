{
  "project": "L-EVK-T2-GH3038Q",
  "version": "1.0",
  "description": "L-EVK-GH3038Q 产测卡控配置文件，包含底噪、PPG噪声、LPCTR和LPLCTR测试项的规则定义。",
  "global": {
    "default_operator": "le",
    "fail_action": "continue"
  },
  "chip": "gh3036",
  "tests": {
    "chip_init": {
      "enabled": true,
      "description": "芯片初始化测试",
      "mode": 1,
      "channels": 1,
      "unit": "status",
      "global_threshold": {
        "operator": "eq",
        "value": 1
      }
    },
    "chip_uid": {
      "enabled": true,
      "description": "芯片UID测试，返回两个128bit UUID，非全0即为PASS"
    },
    "base_noise": {
      "enabled": true,
      "description": "底噪测试",
      "mode": 4,
      "channels": 2,
      "unit": "uV",
      "global_threshold": {
        "operator": "le",
        "value": 100
      }
    },
    "ppg_noise": {
      "enabled": true,
      "description": "PPG噪声测试",
      "mode": 8,
      "channels": 32,
      "unit": "uV",
      "global_threshold": {
        "operator": "le",
        "value": 200
      }
    },
    "lpctr": {
      "enabled": true,
      "description": "LPCTR测试",
      "mode": 16,
      "channels": 32,
      "unit": "nA/mA",
      "global_threshold": {
        "operator": "ge",
        "value": 100
      }
    },
    "lplctr": {
      "enabled": true,
      "description": "LPLCTR测试",
      "mode": 32,
      "channels": 32,
      "unit": "nA/mA",
      "global_threshold": {
        "operator": "le",
        "value": 4
      }
    }
  }
}
